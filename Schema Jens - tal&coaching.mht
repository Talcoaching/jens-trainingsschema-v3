@charset "utf-8";

* { box-sizing: border-box; margin: 0px; padding: 0px; }

:root { --green: #2D4A3E; --cream: #FDFBF3; --gold: #C97B1A; --teal: #2A7A8C; --muted: #6b7c76; --border: #ddd8cc; --white: #fff; --rose: #9B4F6A; --up: #27ae60; --dn: #e74c3c; }

body { background: var(--cream); font-family: Nunito, sans-serif; font-size: 14px; color: var(--green); min-height: 100vh; }

#loginScreen { display: none; align-items: center; justify-content: center; min-height: 100vh; padding: 20px; }

#loginScreen.show { display: flex; }

.lcard { background: var(--white); border-radius: 20px; max-width: 380px; width: 100%; box-shadow: rgba(0, 0, 0, 0.08) 0px 4px 24px; overflow: hidden; }

.lcard-top { background: var(--green); padding: 26px 28px 22px; position: relative; }

.lcard-top::after { content: ""; position: absolute; bottom: 0px; left: 0px; right: 0px; height: 3px; background: linear-gradient(90deg,var(--rose),var(--gold),var(--teal)); }

.lcard-logo { height: 22px; filter: brightness(0) invert(1); }

.lcard-body { padding: 28px; }

.lcard-title { font-family: Fraunces, serif; font-size: 1.5rem; font-weight: 900; color: var(--green); margin-bottom: 6px; }

.lcard-sub { font-size: 13px; color: var(--muted); line-height: 1.6; margin-bottom: 20px; }

.lcard-input { width: 100%; border: 1.5px solid var(--border); border-radius: 10px; padding: 11px 14px; font-family: Nunito, sans-serif; font-size: 14px; color: var(--green); outline: none; background: var(--cream); margin-bottom: 12px; }

.lcard-input:focus { border-color: var(--teal); background: rgb(255, 255, 255); }

.lcard-btn { width: 100%; background: var(--green); color: rgb(255, 255, 255); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 10px; padding: 13px; font-family: Nunito, sans-serif; font-size: 14px; font-weight: 700; cursor: pointer; }

.lcard-msg { margin-top: 12px; font-size: 13px; font-weight: 600; min-height: 18px; text-align: center; }

.lcard-msg.success { color: var(--teal); }

.lcard-msg.error { color: var(--dn); }

#appScreen { display: none; }

#appScreen.show { display: block; }

.header { background: var(--green); padding: 14px 18px; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0px; z-index: 200; }

.header::after { content: ""; position: absolute; bottom: 0px; left: 0px; right: 0px; height: 3px; background: linear-gradient(90deg,var(--rose),var(--gold),var(--teal)); }

.header-logo { height: 18px; filter: brightness(0) invert(1); }

.header-right { display: flex; align-items: center; gap: 8px; }

.header-name { font-family: Fraunces, serif; font-size: 0.85rem; font-style: italic; color: rgba(255, 255, 255, 0.7); }

.sync-status { font-size: 10px; font-weight: 700; color: rgba(255, 255, 255, 0.4); }

.day-toggle { background: var(--white); border-bottom: 1px solid var(--border); padding: 10px 14px; display: flex; gap: 8px; position: sticky; top: 51px; z-index: 100; }

.day-btn { flex: 1 1 0%; padding: 8px; border-radius: 10px; border: 1.5px solid var(--border); background: var(--cream); font-family: Nunito, sans-serif; font-size: 11px; font-weight: 700; color: var(--muted); cursor: pointer; text-align: center; }

.day-btn.active { background: var(--green); border-color: var(--green); color: rgb(255, 255, 255); }

.day-btn .day-label { display: block; font-size: 9px; font-weight: 400; opacity: 0.7; margin-top: 2px; }

.week-nav { background: var(--white); border-bottom: 1px solid var(--border); padding: 8px 14px; display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; position: sticky; top: 99px; z-index: 99; }

.week-nav::-webkit-scrollbar { display: none; }

.week-btn { flex-shrink: 0; padding: 4px 10px; border-radius: 16px; border: 1.5px solid var(--border); background: var(--cream); font-family: Nunito, sans-serif; font-size: 11px; font-weight: 700; color: var(--muted); cursor: pointer; }

.week-btn.active { background: var(--green); border-color: var(--green); color: rgb(255, 255, 255); }

.week-btn.has-data { border-color: var(--teal); color: var(--teal); }

.container { max-width: 720px; margin: 0px auto; padding: 14px 13px 100px; }

.week-meta { margin-bottom: 12px; padding: 0px 4px; }

.week-label { font-family: Fraunces, serif; font-size: 1.2rem; font-weight: 900; }

.week-label span { font-style: italic; color: var(--gold); }

.rir-badge { display: inline-block; font-size: 10px; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; padding: 3px 10px; border-radius: 20px; margin-top: 4px; background: rgb(237, 242, 240); color: var(--green); }

.section-label { font-size: 10px; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; color: var(--muted); margin: 14px 0px 8px 2px; }

.exercise { background: var(--white); border: 1px solid var(--border); border-radius: 12px; padding: 12px 14px; margin-bottom: 10px; }

.exercise.superset { border-color: var(--rose); border-width: 1.5px; }

.exercise.circuit { border-color: var(--teal); background: rgb(247, 252, 253); }

.ex-top { display: flex; align-items: flex-start; gap: 8px; margin-bottom: 6px; }

.ex-name { font-weight: 700; font-size: 14px; color: var(--green); flex: 1 1 0%; }

.ex-tag { font-size: 9px; font-weight: 800; letter-spacing: 0.5px; text-transform: uppercase; padding: 2px 7px; border-radius: 10px; flex-shrink: 0; margin-top: 2px; }

.tag-compound { background: rgb(237, 242, 240); color: var(--green); }

.tag-isolation { background: rgb(253, 246, 236); color: var(--gold); }

.tag-core { background: rgb(238, 247, 249); color: var(--teal); }

.tag-upper { background: rgb(240, 237, 248); color: rgb(108, 52, 131); }

.tag-circuit { background: rgb(238, 247, 249); color: var(--teal); }

.tag-superset { background: rgb(252, 232, 239); color: var(--rose); }

.ex-badges { display: flex; gap: 5px; flex-wrap: wrap; margin-bottom: 6px; }

.badge { font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 10px; }

.badge-reps { background: rgb(252, 232, 239); color: var(--rose); }

.badge-rir { background: rgb(238, 247, 249); color: var(--teal); }

.badge-circuit { background: rgb(238, 247, 249); color: var(--teal); }

.ex-note { font-size: 11px; color: var(--teal); font-style: italic; padding: 5px 8px; background: rgb(238, 247, 249); border-radius: 6px; margin-bottom: 7px; line-height: 1.5; }

.ex-note.rose { background: rgb(252, 232, 239); color: var(--rose); }

.set-hdr { display: grid; grid-template-columns: 20px 1fr 1fr 1fr 44px; gap: 4px; margin-bottom: 3px; }

.set-row { display: grid; grid-template-columns: 20px 1fr 1fr 1fr 44px; gap: 4px; align-items: center; margin-bottom: 3px; }

.col-hdr { font-size: 9px; font-weight: 800; text-transform: uppercase; color: var(--muted); text-align: center; }

.set-num { font-size: 11px; color: var(--muted); font-weight: 700; text-align: center; }

input[type="text"] { width: 100%; background: var(--cream); border: 1px solid var(--border); border-radius: 7px; padding: 5px 3px; font-family: Nunito, sans-serif; font-size: 12px; color: var(--green); text-align: center; outline: none; }

input[type="text"]:focus { border-color: var(--teal); background: rgb(255, 255, 255); }

input::placeholder { color: rgb(204, 204, 204); font-size: 10px; }

.vol-bar { margin-top: 6px; padding: 6px 9px; background: var(--cream); border-radius: 8px; border: 1px solid var(--border); }

.vol-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 3px; }

.vol-num { font-size: 11px; font-weight: 700; }

.vol-diff { font-size: 11px; font-weight: 700; }

.vol-track { height: 3px; background: var(--border); border-radius: 4px; overflow: hidden; }

.vol-fill { height: 100%; border-radius: 4px; transition: width 0.3s; }

.circuit-info { background: var(--teal); border-radius: 10px; padding: 10px 14px; margin-bottom: 10px; }

.circuit-info-title { font-size: 10px; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; color: rgba(255, 255, 255, 0.7); margin-bottom: 4px; }

.circuit-info-text { font-size: 12px; color: rgb(255, 255, 255); line-height: 1.6; }

.notes-block { background: rgb(250, 250, 247); border: 1px solid var(--border); border-radius: 10px; padding: 10px 13px; margin-bottom: 10px; }

.notes-label { font-size: 10px; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; color: var(--muted); display: block; margin-bottom: 4px; }

textarea { width: 100%; background: rgb(255, 255, 255); border: 1px solid var(--border); border-radius: 7px; padding: 6px 8px; font-family: Nunito, sans-serif; font-size: 12px; color: var(--green); outline: none; resize: none; height: 48px; }

textarea:focus { border-color: var(--teal); }

.save-bar { position: fixed; bottom: 0px; left: 0px; right: 0px; background: rgb(255, 255, 255); border-top: 1px solid var(--border); padding: 10px 16px; display: flex; gap: 10px; align-items: center; z-index: 100; }

.btn-save { flex: 1 1 0%; background: var(--green); color: rgb(255, 255, 255); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 10px; padding: 12px; font-family: Nunito, sans-serif; font-size: 14px; font-weight: 700; cursor: pointer; }

.save-msg { font-size: 12px; color: var(--teal); font-weight: 700; display: none; min-width: 80px; }
